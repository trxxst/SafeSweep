# Normalise text files; Windows project, so checkouts use CRLF.
* text=auto

*.cs      text eol=crlf
*.xaml    text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.sln     text eol=crlf
*.wxs     text eol=crlf
*.wixproj text eol=crlf
*.ps1     text eol=crlf
*.config  text eol=crlf
*.manifest text eol=crlf
*.md      text eol=crlf
*.rtf     text eol=crlf
*.yml     text eol=lf
*.yaml    text eol=lf

*.ico  binary
*.png  binary
