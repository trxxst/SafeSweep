<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SafeSweep.App</RootNamespace>
    <AssemblyName>SafeSweep</AssemblyName>
    <!-- Shown as "File description" in Explorer and as the name in Task Manager. -->
    <AssemblyTitle>SafeSweep</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SafeSweep.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeSweep.Core\SafeSweep.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SafeSweep.ico" />
  </ItemGroup>

</Project>
