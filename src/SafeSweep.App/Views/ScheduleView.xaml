<UserControl x:Class="SafeSweep.App.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SafeSweep.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ScheduleViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Style="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <ui:InfoBar Grid.Row="1" Margin="0,16,0,12" Title="Status" Message="{Binding Status}" IsClosable="False" IsOpen="True"
                        Severity="Informational" />

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="When" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Style="{StaticResource Muted}" Text="How often" Margin="0,0,0,4" />
                            <ComboBox Width="160" ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Style="{StaticResource Muted}" Text="Day (weekly)" Margin="0,0,0,4" />
                            <ComboBox Width="160" ItemsSource="{Binding Days}" SelectedItem="{Binding Day}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Style="{StaticResource Muted}" Text="Time (HH:mm)" Margin="0,0,0,4" />
                            <ui:TextBox Width="120" Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                    <CheckBox Content="Skip the scheduled clean when the PC is running on battery" IsChecked="{Binding SkipOnBattery}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                               Text="The task runs only while you are signed in, with your normal (non-administrator) rights. Monthly runs happen on the 1st of the month." />
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="What to clean (Safe Clean categories only)" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Choices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Width="300" Margin="0,2" IsChecked="{Binding IsChecked}" ToolTip="{Binding Definition.Description}">
                                    <TextBlock Text="{Binding Definition.Name}" TextTrimming="CharacterEllipsis" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                               Text="Categories that need administrator rights are skipped by the scheduled task. Browser caches are skipped while the browser is open." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <ui:Button Content="Remove schedule" Margin="0,0,8,0" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveCommand}"
                                   Visibility="{Binding Exists, Converter={StaticResource BoolVis}}" />
                        <ui:Button Content="Save schedule" Appearance="Primary" Icon="{ui:SymbolIcon CalendarClock24}" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
