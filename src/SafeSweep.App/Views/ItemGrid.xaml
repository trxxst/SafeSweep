<UserControl x:Class="SafeSweep.App.Views.ItemGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SafeSweep.App.ViewModels"
             xmlns:views="clr-namespace:SafeSweep.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ItemBrowser}">
    <UserControl.Resources>
        <views:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filter bar -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" Margin="0,0,8,0"
                        PlaceholderText="Search name, path, reason or category"
                        Icon="{ui:SymbolIcon Search24}"
                        ToolTip="Filters the list as you type"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="1" Width="150" Margin="0,0,12,0" VerticalAlignment="Center"
                      ToolTip="Show only one risk level"
                      ItemsSource="{Binding RiskOptions}"
                      SelectedItem="{Binding RiskFilter}" />
            <CheckBox Grid.Column="2" Content="Selected only" VerticalAlignment="Center" Margin="0,0,12,0"
                      ToolTip="Show only the rows you have selected"
                      IsChecked="{Binding OnlySelected}" />
            <TextBlock Grid.Column="3" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                <Run Text="{Binding SelectedShownCount, Mode=OneWay, StringFormat='{}{0:N0} selected, '}" /><Run Text="{Binding VisibleCount, Mode=OneWay, StringFormat={}{0:N0}}" /><Run Text=" of " /><Run Text="{Binding TotalCount, Mode=OneWay, StringFormat={}{0:N0}}" /><Run Text=" shown" />
            </TextBlock>
        </Grid>

        <DataGrid x:Name="ItemsGrid"
                  Grid.Row="1"
                  Style="{StaticResource SafeDataGrid}"
                  ItemsSource="{Binding ItemsView}"
                  SelectedItem="{Binding SelectedItem}"
                  SelectionMode="Single"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  EnableColumnVirtualization="True"
                  AutomationProperties.Name="Items found">
            <DataGrid.InputBindings>
                <KeyBinding Key="Space" Command="{Binding ToggleSelectedItemCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open file location"
                              Command="{Binding Source={StaticResource Proxy}, Path=Data.OpenLocationCommand}"
                              CommandParameter="{Binding Source={StaticResource Proxy}, Path=Data.SelectedItem}" />
                    <MenuItem Header="Copy full path"
                              Command="{Binding Source={StaticResource Proxy}, Path=Data.CopyPathCommand}"
                              CommandParameter="{Binding Source={StaticResource Proxy}, Path=Data.SelectedItem}" />
                    <Separator />
                    <MenuItem Header="Select / deselect (Space)"
                              Command="{Binding Source={StaticResource Proxy}, Path=Data.ToggleSelectedItemCommand}" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="48" MinWidth="48" MaxWidth="48" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                    <DataGridTemplateColumn.Header>
                        <CheckBox HorizontalAlignment="Center"
                                  IsChecked="{Binding Source={StaticResource Proxy}, Path=Data.AllShownSelected, Mode=TwoWay}"
                                  IsEnabled="{Binding Source={StaticResource Proxy}, Path=Data.HasSelectableRows}"
                                  ToolTip="Select or clear every row shown (search and filters apply)"
                                  AutomationProperties.Name="Select all shown rows" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsSelectable}"
                                      ToolTip="{Binding LockReason}"
                                      ToolTipService.ShowOnDisabled="True"
                                      AutomationProperties.Name="{Binding Name}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="240" MinWidth="200" SortMemberPath="Name"
                                    ElementStyle="{StaticResource GridText}" />
                <DataGridTemplateColumn Header="Size" Width="92" MinWidth="92" SortMemberPath="SizeBytes">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource GridText}" Text="{Binding SizeDisplay}" HorizontalAlignment="Right" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Category" Binding="{Binding Category.Name}" Width="170" MinWidth="120"
                                    ElementStyle="{StaticResource GridText}"
                                    Visibility="{Binding Source={StaticResource Proxy}, Path=Data.ShowCategoryColumn, Converter={StaticResource BoolVis}}" />
                <DataGridTextColumn Header="Group" Binding="{Binding DuplicateGroupId}" Width="70" MinWidth="70"
                                    ElementStyle="{StaticResource GridText}"
                                    Visibility="{Binding Source={StaticResource Proxy}, Path=Data.ShowGroupColumn, Converter={StaticResource BoolVis}}" />
                <DataGridTemplateColumn Header="Risk" Width="124" MinWidth="124" SortMemberPath="Risk">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Risk, Converter={StaticResource RiskBrush}}" />
                                <TextBlock Text="{Binding Risk, Converter={StaticResource RiskText}}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Modified" Binding="{Binding LastWriteDisplay}" Width="132" MinWidth="132" SortMemberPath="LastWriteUtc"
                                    ElementStyle="{StaticResource GridText}" />
                <DataGridTextColumn Header="Accessed" Binding="{Binding LastAccessDisplay}" Width="132" MinWidth="132" SortMemberPath="LastAccessUtc"
                                    ElementStyle="{StaticResource GridText}" />
                <DataGridTextColumn Header="Why removable" Binding="{Binding Reason}" Width="300" MinWidth="240"
                                    ElementStyle="{StaticResource GridText}" />
                <DataGridTemplateColumn Header="Full path" Width="*" MinWidth="280" SortMemberPath="Path">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource GridPathText}" views:PathTrimming.FullPath="{Binding Path}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Evidence for the highlighted row -->
        <Border Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource CardBorder}" Padding="12,8"
                Visibility="{Binding SelectedItem, Converter={StaticResource NullVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBox Text="{Binding SelectedItem.Path, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" FontWeight="SemiBold" Padding="0"
                             ToolTip="{Binding SelectedItem.Path}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsCompactHeight, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="TextWrapping" Value="NoWrap" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Margin="0,4,0,0" FontSize="13" Text="{Binding SelectedItem.EvidenceDisplay}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedItem.EvidenceDisplay}">
                        <TextBlock.Style>
                            <!-- MaxHeight lives in the style: a local value would outrank the trigger. -->
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="MaxHeight" Value="66" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsCompactHeight, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="MaxHeight" Value="18" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Text="{Binding SelectedItem.LockReason}"
                               Visibility="{Binding SelectedItem.LockReason, Converter={StaticResource NullVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsCompactHeight, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Orientation" Value="Horizontal" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:Button Style="{StaticResource RowButton}" Content="Open location" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,6,6" HorizontalAlignment="Stretch"
                               ToolTip="Show this item in File Explorer"
                               Command="{Binding OpenLocationCommand}" CommandParameter="{Binding SelectedItem}" />
                    <ui:Button Style="{StaticResource RowButton}" Content="Copy path" Icon="{ui:SymbolIcon Copy24}" HorizontalAlignment="Stretch"
                               ToolTip="Copy the full path to the clipboard"
                               Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedItem}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
