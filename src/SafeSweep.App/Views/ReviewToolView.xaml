<UserControl x:Class="SafeSweep.App.Views.ReviewToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SafeSweep.App.ViewModels"
             xmlns:views="clr-namespace:SafeSweep.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReviewToolViewModel}">
    <Grid Style="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Scope -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,12" IsEnabled="{Binding IsIdle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Visibility="{Binding UsesRoots, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Folders to scan" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Roots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,6,6" Padding="10,4,4,4" CornerRadius="14"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                            <ui:Button Margin="6,0,0,0" Padding="4" Appearance="Transparent"
                                                       Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Remove this folder"
                                                       Command="{Binding DataContext.RemoveRootCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Muted}" MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip="Program folders, AppData, OneDrive, game libraries, version-control folders and system files are always skipped, whatever you add here."
                                   Text="Program folders, AppData, OneDrive, game libraries, version-control folders and system files are always skipped, whatever you add here." />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Body}" MaxHeight="60" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding UsesRoots, Converter={StaticResource InvBoolVis}}"
                               Text="Checks the top-level folders of AppData (Roaming, Local, LocalLow), ProgramData and Store app data against every installed program, Store package, service, startup entry, scheduled task, PATH entry and running process. Only folders unused for a long time are listed, and everything found is quarantined rather than deleted." />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top" MinWidth="220">
                    <ui:Button Content="Add folder..." Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                               Command="{Binding AddRootCommand}"
                               Visibility="{Binding UsesRoots, Converter={StaticResource BoolVis}}" />
                    <StackPanel Visibility="{Binding UsesParameter, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
                        <TextBlock Text="{Binding ParameterLabel}" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                        <ui:NumberBox Value="{Binding Parameter, Mode=TwoWay}" Minimum="{Binding ParameterMinimum}" Maximum="1048576"
                                      SmallChange="10" LargeChange="100" MaxDecimalPlaces="0" />
                    </StackPanel>
                    <ui:Button Appearance="Primary" Content="{Binding ScanButtonText}" Icon="{ui:SymbolIcon Search24}"
                               HorizontalAlignment="Stretch" Command="{Binding ScanCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,12"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ProgressStage}" FontWeight="SemiBold" />
                    <ProgressBar Margin="0,8,0,8" Height="4" IsIndeterminate="{Binding ProgressIndeterminate}" Value="{Binding ProgressValue}" Maximum="100" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding ProgressDetail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
                <ui:Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Content="Cancel"
                           Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelCommand}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3">
            <ui:InfoBar Title="Finished" Message="{Binding CleanMessage}" Severity="{Binding CleanSeverity}"
                        IsOpen="{Binding ShowCleanMessage, Mode=TwoWay}" IsClosable="True" Margin="0,0,0,8" />
            <Expander Header="Items that were skipped or refused" Margin="0,0,0,8"
                      Visibility="{Binding Problems.Count, Converter={StaticResource CountVis}}">
                <ListBox ItemsSource="{Binding Problems}" MaxHeight="160" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Skipped or refused items">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" FontSize="12">
                                <Run Text="{Binding Item.Path, Mode=OneWay}" />
                                <Run Text=" - " />
                                <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Expander>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" Text="{Binding ResultSummary}"
                       Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}" />
            <ui:InfoBar Title="Notes" Severity="Informational" IsClosable="False" Message="{Binding Notes}" Margin="0,0,0,8"
                        IsOpen="{Binding HasNotes, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="4" Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
            <views:ItemGrid DataContext="{Binding Browser}" />
        </Grid>

        <Border Grid.Row="5" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="12"
                Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,16,0">
                    <TextBlock Style="{StaticResource Muted}" Text="Selected" />
                    <TextBlock FontSize="18" FontWeight="SemiBold">
                        <Run Text="{Binding SelectedBytes, Mode=OneWay, Converter={StaticResource Bytes}}" />
                        <Run FontSize="13" FontWeight="Normal" Text="{Binding SelectedCount, Mode=OneWay, StringFormat={}in {0:N0} items}" />
                    </TextBlock>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}">
                    <ui:Button Content="Keep newest, select other copies" Margin="0,0,6,0"
                               Command="{Binding SelectAllButOneCommand}" CommandParameter="newest"
                               Visibility="{Binding IsDuplicates, Converter={StaticResource BoolVis}}" />
                    <ui:Button Content="Keep oldest, select other copies" Margin="0,0,6,0"
                               Command="{Binding SelectAllButOneCommand}" CommandParameter="oldest"
                               Visibility="{Binding IsDuplicates, Converter={StaticResource BoolVis}}" />
                    <ui:Button Content="Deselect all" Command="{Binding DeselectAllCommand}" />
                </WrapPanel>
                <ui:Button Grid.Column="2" Style="{StaticResource PrimaryAction}" Icon="{ui:SymbolIcon ArchiveArrowBack24}"
                           Content="Remove selected..." IsEnabled="{Binding IsIdle}"
                           Command="{Binding RemoveSelectedCommand}"
                           ToolTip="Selected items are quarantined (or sent to the Recycle Bin if you chose that in Settings). Never deleted outright." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
