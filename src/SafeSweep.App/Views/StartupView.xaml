<UserControl x:Class="SafeSweep.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SafeSweep.App.ViewModels"
             xmlns:views="clr-namespace:SafeSweep.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StartupViewModel}">
    <UserControl.Resources>
        <views:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </UserControl.Resources>
    <Grid Style="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,12" LastChildFill="True">
            <ui:Button DockPanel.Dock="Right" Margin="12,0,0,0" Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}"
                       ToolTip="Read the startup entries again" Command="{Binding RefreshCommand}" />
            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Text="{Binding Summary}" />
        </DockPanel>

        <DataGrid Grid.Row="2" Style="{StaticResource SafeDataGrid}" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" SelectionMode="Single" RowHeight="40" AutomationProperties.Name="Startup programs">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="On" Width="80" SortMemberPath="IsEnabled">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:ToggleSwitch VerticalAlignment="Center"
                                             IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                             Command="{Binding Source={StaticResource Proxy}, Path=Data.ToggleCommand}"
                                             CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" MinWidth="140" ElementStyle="{StaticResource GridText}" />
                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="170" MinWidth="120" ElementStyle="{StaticResource GridText}" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="120" MinWidth="110" ElementStyle="{StaticResource GridText}" />
                <DataGridTextColumn Header="Where it is registered" Binding="{Binding SourceDisplay}" Width="200" MinWidth="150" ElementStyle="{StaticResource GridText}" />
                <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*" MinWidth="240" ElementStyle="{StaticResource GridText}" />
                <DataGridTemplateColumn Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Content="Open location" Style="{StaticResource RowButton}" ToolTip="Show the program file in File Explorer"
                                       Command="{Binding Source={StaticResource Proxy}, Path=Data.OpenLocationCommand}"
                                       CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
