<UserControl x:Class="SafeSweep.App.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SafeSweep.App.ViewModels"
             xmlns:views="clr-namespace:SafeSweep.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CleanerViewModel}">
    <Grid Style="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header with scan buttons -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}">
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Sparkle24}" Content="Quick Scan" Margin="0,0,8,0"
                           Command="{Binding QuickScanCommand}"
                           ToolTip="Safe Clean categories only: temporary files, caches, error reports, browser caches. Fast." />
                <ui:Button Icon="{ui:SymbolIcon FolderSearch24}" Content="Full Scan" Margin="0,0,8,0"
                           Command="{Binding FullScanCommand}"
                           ToolTip="Everything: Safe and Deep Clean categories plus leftovers, empty folders, old installers and old files for review." />
                <ui:Button Icon="{ui:SymbolIcon Filter24}" Content="Custom Scan..."
                           Command="{Binding ToggleCustomCommand}"
                           ToolTip="Choose exactly which categories to scan." />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CompactHidden}">
            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,10" Text="{Binding ResultSummary}"
                       Visibility="{Binding ResultSummary, Converter={StaticResource NullVis}}" />
        </Border>
        <Border Grid.Row="1" Height="10" Style="{StaticResource CompactOnly}" />

        <!-- Progress -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,12"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ProgressStage}" FontWeight="SemiBold" />
                    <ProgressBar Margin="0,8,0,8" Height="4" IsIndeterminate="{Binding ProgressIndeterminate}" Value="{Binding ProgressValue}" Maximum="100" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding ProgressDetail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding ProgressCounts}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Content="Cancel"
                           Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelCommand}" />
            </Grid>
        </Border>

        <!-- Result of the last clean -->
        <StackPanel Grid.Row="3">
            <ui:InfoBar Title="Clean finished" Message="{Binding CleanMessage}" Severity="{Binding CleanSeverity}"
                        IsOpen="{Binding ShowCleanMessage, Mode=TwoWay}" IsClosable="True" Margin="0,0,0,8" />
            <Expander Header="Items that were skipped or refused (click for details)" Margin="0,0,0,12"
                      Visibility="{Binding Problems.Count, Converter={StaticResource CountVis}}">
                <ListBox ItemsSource="{Binding Problems}" MaxHeight="180" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Skipped or refused items">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Item.Path}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="{Binding Outcome, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=": " />
                                    <Run Text="{Binding Detail, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Expander>
        </StackPanel>

        <!-- Empty state -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="28" VerticalAlignment="Top"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Text="Nothing scanned yet" Style="{StaticResource SectionTitle}" FontSize="20" />
                <TextBlock Style="{StaticResource Body}" Margin="0,0,0,12"
                           Text="Scanning only reads your disk; nothing is changed until you review the results and press Clean." />
                <TextBlock Style="{StaticResource Body}" Margin="0,4"><Run FontWeight="SemiBold" Text="Quick Scan" /><Run Text=" - Safe Clean only: files that are regenerated automatically and are never your data." /></TextBlock>
                <TextBlock Style="{StaticResource Body}" Margin="0,4"><Run FontWeight="SemiBold" Text="Full Scan" /><Run Text=" - adds Deep Clean (caches, logs, update and driver leftovers, quarantined rather than deleted) and Manual Review (leftovers, empty folders, old installers and old files, never selected for you)." /></TextBlock>
                <TextBlock Style="{StaticResource Body}" Margin="0,4"><Run FontWeight="SemiBold" Text="Custom Scan" /><Run Text=" - pick the categories yourself." /></TextBlock>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Grid Grid.Row="4" Visibility="{Binding ShowResults, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="250" MaxWidth="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <!-- Categories -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CompactHiddenCard}" Padding="12" Margin="0,0,0,8">
                    <UniformGrid Columns="3">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Text="Safe Clean" />
                            <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="{Binding SafeBytes, Converter={StaticResource Bytes}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Text="Deep Clean" />
                            <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding DeepBytes, Converter={StaticResource Bytes}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Text="Manual Review" />
                            <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding ReviewBytes, Converter={StaticResource Bytes}}" />
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding CategoriesView}" IsSynchronizedWithCurrentItem="False"
                         SelectedItem="{Binding SelectedCategory}"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         AutomationProperties.Name="Categories"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,12,4,4">
                                        <StackPanel Orientation="Horizontal"
                                                    ToolTip="{Binding Converter={StaticResource LevelText}, ConverterParameter=explain}">
                                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Name, Converter={StaticResource RiskBrush}}" />
                                            <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding Converter={StaticResource LevelText}}" />
                                        </StackPanel>
                                        <Border Style="{StaticResource CompactHidden}">
                                            <TextBlock Style="{StaticResource Muted}" Margin="18,2,0,0"
                                                       Text="{Binding Converter={StaticResource LevelText}, ConverterParameter=explain}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding Definition.Name}"
                                          ToolTip="Select or clear every selectable item in this category (partly filled = some are selected)" />
                                <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Definition.Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Definition.Description}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding TotalCount, StringFormat={}{0:N0} items}" />
                                        <TextBlock Style="{StaticResource Muted}" Text=", selected: " />
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding SelectedDisplay}" />
                                        <ui:SymbolIcon Symbol="Info24" FontSize="14" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       ToolTip="{Binding NotesDisplay}"
                                                       Visibility="{Binding HasNotes, Converter={StaticResource BoolVis}}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding TotalDisplay}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Details -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,0,8">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Show all items" Icon="{ui:SymbolIcon AppsList24}"
                                       Command="{Binding ShowAllCommand}"
                                       Visibility="{Binding IsAllSelected, Converter={StaticResource InvBoolVis}}" />
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DetailTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,0,12,4" VerticalAlignment="Center" />
                                <WrapPanel VerticalAlignment="Center" Visibility="{Binding IsAllSelected, Converter={StaticResource InvBoolVis}}">
                                    <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding SelectedCategory.Definition.Level, Converter={StaticResource RiskBrush}}" />
                                            <TextBlock FontSize="12" Text="{Binding SelectedCategory.Definition.Level, Converter={StaticResource LevelText}}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding SelectedCategory.Definition.Risk, Converter={StaticResource RiskBrush}}" />
                                            <TextBlock FontSize="12" Text="{Binding SelectedCategory.Definition.Risk, Converter={StaticResource RiskText}}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <TextBlock FontSize="12" Text="{Binding SelectedCategory.Definition.DefaultMethod, Converter={StaticResource MethodText}}" />
                                    </Border>
                                    <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                            Visibility="{Binding SelectedCategory.Definition.RequiresAdmin, Converter={StaticResource BoolVis}}">
                                        <TextBlock FontSize="12" Text="Needs administrator rights" />
                                    </Border>
                                </WrapPanel>
                            </WrapPanel>
                        </DockPanel>

                        <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0"
                                   Visibility="{Binding IsAllSelected, Converter={StaticResource BoolVis}}"
                                   Text="Every item from every category. Click a category on the left to see what it is, why it is removable and what happens afterwards." />

                        <StackPanel Visibility="{Binding IsAllSelected, Converter={StaticResource InvBoolVis}}">
                            <TextBlock Style="{StaticResource Body}" FontSize="13" Text="{Binding SelectedCategory.Definition.Description}">
                                <TextBlock.ToolTip>
                                    <StackPanel MaxWidth="460">
                                        <TextBlock TextWrapping="Wrap"><Run FontWeight="SemiBold" Text="Why removable: " /><Run Text="{Binding SelectedCategory.Definition.WhyRemovable, Mode=OneWay}" /></TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"><Run FontWeight="SemiBold" Text="Afterwards: " /><Run Text="{Binding SelectedCategory.Definition.AfterEffects, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <StackPanel Style="{StaticResource CompactHidden}">
                                <TextBlock Style="{StaticResource Body}" FontSize="13" Margin="0,4,0,0">
                                    <Run FontWeight="SemiBold" Text="Why removable: " /><Run Text="{Binding SelectedCategory.Definition.WhyRemovable, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Body}" FontSize="13" Margin="0,2,0,0">
                                    <Run FontWeight="SemiBold" Text="Afterwards: " /><Run Text="{Binding SelectedCategory.Definition.AfterEffects, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Border Style="{StaticResource CompactHidden}">
                                <ui:InfoBar Margin="0,8,0,0" Title="Notes" Severity="Warning" IsClosable="False"
                                            Message="{Binding SelectedCategory.NotesDisplay}"
                                            IsOpen="{Binding SelectedCategory.HasNotes, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <views:ItemGrid Grid.Row="1" DataContext="{Binding Browser}" />
            </Grid>
        </Grid>

        <!-- Custom scan chooser (also usable before the first scan) -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                Visibility="{Binding IsCustomOpen, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Custom Scan: choose categories" Style="{StaticResource SectionTitle}" FontSize="18" />
                    <TextBlock Style="{StaticResource Muted}" Text="Hover a category for its explanation. Large files and duplicates have their own pages under Review." />
                    <WrapPanel Margin="0,8,0,8">
                        <ui:Button Content="All Safe Clean" Margin="0,0,6,0" Command="{Binding CustomSelectAllCommand}" CommandParameter="Safe Clean" />
                        <ui:Button Content="All Deep Clean" Margin="0,0,6,0" Command="{Binding CustomSelectAllCommand}" CommandParameter="Deep Clean" />
                        <ui:Button Content="All Manual Review" Margin="0,0,6,0" Command="{Binding CustomSelectAllCommand}" CommandParameter="Manual Review" />
                        <ui:Button Content="Clear" Command="{Binding CustomClearCommand}" />
                    </WrapPanel>
                </StackPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding CustomChoicesView}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,10,0,4" FontWeight="SemiBold" Text="{Binding Name}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Width="300" Margin="0,2" IsChecked="{Binding IsChecked}">
                                <CheckBox.ToolTip>
                                    <StackPanel MaxWidth="420">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Definition.Name}" />
                                        <TextBlock TextWrapping="Wrap" Text="{Binding Definition.Description}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Definition.WhyRemovable}" />
                                    </StackPanel>
                                </CheckBox.ToolTip>
                                <TextBlock Text="{Binding Definition.Name}" TextTrimming="CharacterEllipsis" />
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <ui:Button Content="Close" Margin="0,0,8,0" Command="{Binding ToggleCustomCommand}" />
                    <ui:Button Appearance="Primary" Content="Start Custom Scan" Icon="{ui:SymbolIcon Play24}" Command="{Binding CustomScanCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action bar -->
        <Border Grid.Row="5" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="12"
                Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,16,0">
                    <TextBlock Style="{StaticResource Muted}" Text="Selected" />
                    <TextBlock FontSize="18" FontWeight="SemiBold">
                        <Run Text="{Binding SelectedBytes, Mode=OneWay, Converter={StaticResource Bytes}}" />
                        <Run FontSize="13" FontWeight="Normal" Text="{Binding SelectedCount, Mode=OneWay, StringFormat={}in {0:N0} items}" />
                    </TextBlock>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}">
                    <ui:Button Content="Select recommended" Margin="0,2,6,2" Command="{Binding SelectRecommendedCommand}"
                               ToolTip="Select every Safe Clean item (what SafeSweep recommends) and nothing else." />
                    <ui:Button Content="Safe + Deep" Margin="0,2,6,2" Command="{Binding SelectSafeAndDeepCommand}"
                               ToolTip="Select every selectable Safe and Deep item. Manual Review items and the Recycle Bin are never bulk-selected." />
                    <ui:Button Content="Deselect all" Margin="0,2,6,2" Command="{Binding DeselectAllCommand}" ToolTip="Clear every selection." />
                </WrapPanel>
                <ui:Button Grid.Column="2" Style="{StaticResource PrimaryAction}" Icon="{ui:SymbolIcon Broom24}" Content="Clean selected..."
                           ToolTip="Shows exactly what will happen to the selected items and asks you to confirm."
                           IsEnabled="{Binding IsIdle}" Command="{Binding CleanCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
