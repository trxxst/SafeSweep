<UserControl x:Class="SafeSweep.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SafeSweep.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,20" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource CardBorder}" Margin="0,20,0,12">
                <StackPanel>
                    <TextBlock Text="How items are removed" Style="{StaticResource SectionTitle}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <StackPanel Margin="0,0,120,0">
                            <TextBlock Text="Simulation mode" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" Text="Every clean becomes a preview: SafeSweep reports what it would do and changes nothing." />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding SimulationMode}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <StackPanel Margin="0,0,120,0">
                            <TextBlock Text="Use the Recycle Bin for review items" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" Text="Large, duplicate, old files and old installers go to the Windows Recycle Bin instead of SafeSweep's quarantine. Only used when the Recycle Bin is guaranteed to keep the file (enabled on that drive and big enough); otherwise quarantine is used." />
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding UseRecycleBinForReview}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <StackPanel Margin="0,0,200,0">
                            <TextBlock Text="Keep quarantined items for (days)" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" Text="After this they are purged automatically. 0 keeps them until you purge them yourself." />
                        </StackPanel>
                        <ui:NumberBox HorizontalAlignment="Right" Width="180" Minimum="0" Maximum="3650" MaxDecimalPlaces="0" Value="{Binding QuarantineRetentionDays}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Detection thresholds" Style="{StaticResource SectionTitle}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <StackPanel Margin="0,0,200,0">
                            <TextBlock Text="Temporary file safety window (hours)" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" Text="Temporary files changed or created more recently than this are left alone, because a running installer may still need them." />
                        </StackPanel>
                        <ui:NumberBox HorizontalAlignment="Right" Width="180" Minimum="1" Maximum="2160" MaxDecimalPlaces="0" Value="{Binding TempMinAgeHours}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <StackPanel Margin="0,0,200,0">
                            <TextBlock Text="Large file threshold (MB)" FontWeight="SemiBold" />
                        </StackPanel>
                        <ui:NumberBox HorizontalAlignment="Right" Width="180" Minimum="10" Maximum="1048576" MaxDecimalPlaces="0" Value="{Binding LargeFileThresholdMb}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <StackPanel Margin="0,0,200,0">
                            <TextBlock Text="Old file age (days)" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" Text="Files not modified (and not created) for this long appear under Old / unused files. Never selected automatically." />
                        </StackPanel>
                        <ui:NumberBox HorizontalAlignment="Right" Width="180" Minimum="30" Maximum="10950" MaxDecimalPlaces="0" Value="{Binding OldFileDays}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <StackPanel Margin="0,0,200,0">
                            <TextBlock Text="Old installer age (days)" FontWeight="SemiBold" />
                        </StackPanel>
                        <ui:NumberBox HorizontalAlignment="Right" Width="180" Minimum="7" Maximum="3650" MaxDecimalPlaces="0" Value="{Binding OldInstallerDays}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <StackPanel Margin="0,0,200,0">
                            <TextBlock Text="Minimum duplicate size (KB)" FontWeight="SemiBold" />
                        </StackPanel>
                        <ui:NumberBox HorizontalAlignment="Right" Width="180" Minimum="1" Maximum="1048576" MaxDecimalPlaces="0" Value="{Binding DuplicateMinSizeKb}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <StackPanel Margin="0,0,200,0">
                            <TextBlock Text="Leftover folders unused for at least (days)" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" Text="Higher is safer: portable programs have no uninstall entry and can look uninstalled." />
                        </StackPanel>
                        <ui:NumberBox HorizontalAlignment="Right" Width="180" Minimum="7" Maximum="3650" MaxDecimalPlaces="0" Value="{Binding LeftoverMinIdleDays}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Folders for the review tools" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding ReviewRoots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,120,0" ToolTip="{Binding}" />
                                    <ui:Button HorizontalAlignment="Right" Style="{StaticResource RowButton}" Content="Remove" ToolTip="Stop scanning this folder in the review tools"
                                               Command="{Binding DataContext.RemoveRootCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button Content="Add folder..." Icon="{ui:SymbolIcon Add24}" Margin="0,8,0,0" Command="{Binding AddRootCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                    <ComboBox Width="200" HorizontalAlignment="Left" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0">
                        <Run Text="Settings, logs, history and the quarantine live in " /><Run Text="{Binding DataFolder, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Body}">
                        <Run FontWeight="SemiBold" Text="{Binding VersionText, Mode=OneWay}" />
                        <Run Text=" - open-source Windows storage cleaner, MIT licence." />
                    </TextBlock>
                    <WrapPanel Margin="0,10,0,0">
                        <ui:Button Content="Project page" Icon="{ui:SymbolIcon Open24}" Margin="0,0,8,0" Command="{Binding OpenLinkCommand}" CommandParameter="repo"
                                   ToolTip="Source code, documentation and releases on GitHub" />
                        <ui:Button Content="Check for new releases" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,8,0" Command="{Binding OpenLinkCommand}" CommandParameter="releases" />
                        <ui:Button Content="Report a problem" Icon="{ui:SymbolIcon ErrorCircle24}" Command="{Binding OpenLinkCommand}" CommandParameter="issues"
                                   ToolTip="Opens GitHub Issues. Review logs for private paths before attaching them." />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <ui:Button Style="{StaticResource PrimaryAction}" MinWidth="120" Content="Save" Icon="{ui:SymbolIcon Checkmark24}" Margin="0,0,8,0" Command="{Binding SaveCommand}" />
                <ui:Button Content="Load defaults" Command="{Binding ResetDefaultsCommand}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding SavedMessage}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
