<UserControl x:Class="SafeSweep.App.Views.ProtectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SafeSweep.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProtectionViewModel}">
    <Grid Style="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <TabControl Grid.Row="1" Style="{StaticResource PivotTabControl}">
            <TabItem Header="Protected locations">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:TextBox Width="360" HorizontalAlignment="Left" Margin="0,0,0,8" PlaceholderText="Filter locations"
                                Icon="{ui:SymbolIcon Search24}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding LocationsView}" IsSynchronizedWithCurrentItem="False" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Protected locations">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="4,12,0,4" FontWeight="SemiBold" FontSize="14" Text="{Binding Name}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Rules">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="General rules" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Body}" Text="{Binding GeneralRules}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Protected file names and types (refused anywhere on disk)" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Body}" Text="{Binding ProtectedNames}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Protected folder names (refused anywhere in a path)" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Body}" Text="{Binding ProtectedFolderNames}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Browser profile data (only caches next to these are cleaned)" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Body}" Text="{Binding BrowserNames}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Cleanable exceptions inside protected locations (built-in rules only)" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding Exceptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Your exclusions">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,8"
                               Text="Folders listed here are never scanned or cleaned by any category or tool. Environment variables such as %LOCALAPPDATA% are expanded." />
                    <ItemsControl ItemsSource="{Binding Exclusions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Padding="12,6" Margin="0,0,0,6">
                                    <Grid>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,120,0" ToolTip="{Binding}" />
                                        <ui:Button HorizontalAlignment="Right" Style="{StaticResource RowButton}" Content="Remove" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Stop excluding this folder"
                                                   Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button Content="Add folder..." Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Margin="0,8,0,0"
                               HorizontalAlignment="Left" Command="{Binding AddExclusionCommand}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
