<UserControl x:Class="SafeSweep.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SafeSweep.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LogsViewModel}">
    <Grid Style="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon DocumentText24}" Content="Today's log"
                           ToolTip="Open today's full log file (review it for private paths before sharing it)" Command="{Binding OpenTodayCommand}" />
                <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Content="Log folder" ToolTip="Open the folder with all daily log files" Command="{Binding OpenFolderCommand}" />
            </StackPanel>
            <WrapPanel>
                <ComboBox Width="200" Margin="0,0,8,0" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" ToolTip="Which log lines to show" />
                <ui:TextBox Width="260" PlaceholderText="Search the log" Icon="{ui:SymbolIcon Search24}"
                            Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            </WrapPanel>
        </DockPanel>

        <ListBox Grid.Row="2" ItemsSource="{Binding EntriesView}" IsSynchronizedWithCurrentItem="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Log entries"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="6,2" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{Binding Timestamp, Mode=OneWay, StringFormat=HH:mm:ss}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding LevelText, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="{Binding Message, Mode=OneWay}" />
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
