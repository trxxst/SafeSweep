<UserControl x:Class="SafeSweep.App.Views.WindowsToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SafeSweep.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WindowsToolsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,20">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource CardBorder}" Margin="0,20,0,12">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <ui:Button DockPanel.Dock="Right" Margin="12,0,0,8" Content="Check again" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   ToolTip="Look for previous Windows installations and upgrade files again" Command="{Binding CheckCommand}" />
                        <TextBlock Text="Previous Windows installations and upgrade files" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding LeftoverSummary}" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8" Visibility="{Binding IsMeasuring, Converter={StaticResource BoolVis}}" />
                    <ItemsControl ItemsSource="{Binding UpgradeLeftovers}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Path}" />
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Description}" />
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding SizeDisplay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                               Text="These are removed through Windows Settings > System > Storage > Temporary files (look for 'Previous Windows installation(s)' and 'Windows upgrade log files') or the classic Disk Cleanup." />
                    <WrapPanel Margin="0,10,0,0">
                        <ui:Button Content="Open Storage settings" Icon="{ui:SymbolIcon Storage24}" Margin="0,0,8,0" Command="{Binding OpenStorageSettingsCommand}" />
                        <ui:Button Content="Open Disk Cleanup" Icon="{ui:SymbolIcon Broom24}" Command="{Binding OpenDiskCleanupCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Component store (WinSxS)" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Body}"
                               Text="WinSxS looks huge in Explorer but is mostly hard links to files in System32, so its real size is much smaller. Deleting from it breaks Windows. Microsoft's DISM tool can safely remove component versions that updates have replaced." />
                    <WrapPanel Margin="0,10,0,0">
                        <ui:Button Content="Analyse (read-only)" Icon="{ui:SymbolIcon DataUsage24}" Margin="0,0,8,0" Command="{Binding AnalyzeComponentStoreCommand}" />
                        <ui:Button Content="Run component cleanup" Icon="{ui:SymbolIcon Wrench24}" Command="{Binding ComponentCleanupCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Delivery Optimization cache" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Body}"
                               Text="Windows keeps update files it can share with other PCs. The cache is managed by a system service, so it is cleared with Windows' own command rather than by deleting files." />
                    <ui:Button Margin="0,10,0,0" Content="Clear with Windows' command" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding DeliveryOptimizationCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
