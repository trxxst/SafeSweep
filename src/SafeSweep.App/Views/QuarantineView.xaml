<UserControl x:Class="SafeSweep.App.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SafeSweep.App.ViewModels"
             xmlns:views="clr-namespace:SafeSweep.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:QuarantineViewModel}">
    <Grid Style="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12">
            <DockPanel LastChildFill="True">
                <ui:Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Content="Open quarantine folder"
                           ToolTip="Open SafeSweep's quarantine store in File Explorer"
                           Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenFolderCommand}" />
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold">
                        <Run Text="{Binding TotalBytes, Mode=OneWay, Converter={StaticResource Bytes}}" />
                        <Run FontSize="14" FontWeight="Normal" Text="{Binding Rows.Count, Mode=OneWay, StringFormat={}in {0:N0} item(s)}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding RetentionText}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock Style="{StaticResource Muted}" Margin="0,20" HorizontalAlignment="Center" FontSize="14"
                       Text="The quarantine is empty."
                       Visibility="{Binding Rows.Count, Converter={StaticResource InvCountVis}}" />
            <DataGrid Style="{StaticResource SafeDataGrid}" ItemsSource="{Binding Rows}" SelectionMode="Single"
                      AutomationProperties.Name="Quarantined items"
                      Visibility="{Binding Rows.Count, Converter={StaticResource CountVis}}">
                <DataGrid.Resources>
                    <views:BindingProxy x:Key="Proxy" Data="{Binding}" />
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="48" MinWidth="48" MaxWidth="48" CanUserResize="False" CanUserSort="False" CanUserReorder="False">
                        <DataGridTemplateColumn.Header>
                            <CheckBox HorizontalAlignment="Center"
                                      IsChecked="{Binding Source={StaticResource Proxy}, Path=Data.AllSelected, Mode=TwoWay}"
                                      ToolTip="Select or clear every quarantined item"
                                      AutomationProperties.Name="Select all quarantined items" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="{Binding Entry.Name}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Entry.Name}" Width="200" MinWidth="120" ElementStyle="{StaticResource GridText}" />
                    <DataGridTemplateColumn Header="Size" Width="92" MinWidth="92" SortMemberPath="Entry.SizeBytes">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource GridText}" HorizontalAlignment="Right" Text="{Binding Entry.SizeDisplay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Quarantined" Binding="{Binding Entry.QuarantinedLocal, StringFormat=g}" Width="150" MinWidth="150" SortMemberPath="Entry.QuarantinedUtc" ElementStyle="{StaticResource GridText}" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Entry.CategoryName}" Width="190" MinWidth="120" ElementStyle="{StaticResource GridText}" />
                    <DataGridTemplateColumn Header="Original location" Width="*" MinWidth="260" SortMemberPath="Entry.OriginalPath">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource GridPathText}" views:PathTrimming.FullPath="{Binding Entry.OriginalPath}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Reason" Binding="{Binding Entry.Reason}" Width="260" MinWidth="160" ElementStyle="{StaticResource GridText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="12" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="Purge permanently..." Margin="0,0,8,0" Appearance="Danger" MinHeight="36"
                               ToolTip="Delete the selected quarantined items for good. They can no longer be restored."
                               Icon="{ui:SymbolIcon Delete24}" Command="{Binding PurgeSelectedCommand}" />
                    <ui:Button Content="Restore selected" Style="{StaticResource PrimaryAction}"
                               ToolTip="Move the selected items back to where they were (never overwrites a newer file)."
                               Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding RestoreSelectedCommand}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Margin="4,0,12,0" TextTrimming="CharacterEllipsis">
                    <Run FontWeight="SemiBold" Text="{Binding SelectedCount, Mode=OneWay, StringFormat={}{0:N0} selected}" />
                    <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SelectedBytes, Mode=OneWay, Converter={StaticResource Bytes}}" />
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
