<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- Builds SafeSweep-Setup-x64.exe: a small setup program around the MSI. -->
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>SafeSweep-Setup-x64</OutputName>
    <!-- VersionPrefix comes from Directory.Build.props, the single place the version is set. -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">$(VersionPrefix)</ProductVersion>
    <MsiPath Condition="'$(MsiPath)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\msi\SafeSweep-x64.msi</MsiPath>
    <DefineConstants>ProductVersion=$(ProductVersion);MsiPath=$(MsiPath)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
